  m_Script: {fileID: 11500000, guid: 8741931c1612f6b4487eff7c60c7f433, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoUnico
  dialogopanel: {fileID: 149167303}
  caradialogo: {fileID: 1240701583}
  Cara: {fileID: 7229178153557163114, guid: a4737d84ce795584fb6a801d504252ac, type: 3}
  texto: {fileID: 727939126}
  lineasDialogo:
  - So you're the one I was waiting for.
  - Nice to meet you, Elias. I'm the mayor. Welcome to town.
  - The storm left us without electricity, but I hope this isn't a problem for you.
  - I hope your stay here is pleasant; for this reason, I have given you a map.
  typingtext: 0.05
  dialogoNormal: {fileID: 552952881}
  panelDespuesDialogo: {fileID: 1894579989}
  fadePanel: {fileID: 1894579991}
  audioSource: {fileID: 552952887}
  sonido: {fileID: 8300000, guid: d412e9a5b4bb5744893a39a75ca6de7d, type: 3}
  duracionSonido: 1
  duracionFadeSonido: 0.3
  lineasDialogoDespuesSonido:
  - Did you hear that? It sounds like it's coming from Gabriel's house.
  tiempoAntesDialogo: 1
