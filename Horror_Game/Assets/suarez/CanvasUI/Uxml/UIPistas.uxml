<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/suarez/Boton_UI_Toolkit.uss?fileID=7433441132597879392&amp;guid=ca1ce4194dac0444a8d8cac38382354f&amp;type=3#Boton_UI_Toolkit"/>
    <ui:VisualElement name="CanvasPistas" enabled="true" style="flex-grow: 1; position: absolute; height: 1024px; width: 1827px; top: 23px; left: 52px; align-items: center; background-color: rgb(0, 0, 0); background-image: url(&quot;project://database/Assets/isa/Paneles/2.png?fileID=2800000&amp;guid=f7c7888d184c5194aa743b78a3e7980a&amp;type=3#2&quot;); background-size: 125% 137%; align-content: auto; justify-content: flex-start; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; border-left-color: rgba(0, 0, 0, 0.39); border-right-color: rgba(0, 0, 0, 0.39); border-top-color: rgba(0, 0, 0, 0.39); border-bottom-color: rgba(0, 0, 0, 0.39); display: flex;">
        <ui:Label text="YOU&apos;VE FOUND A CLUE!" name="HOWTOPLAY" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 2px; font-size: 80px; -unity-text-outline-color: rgb(0, 0, 0); top: 9px; left: 343px;"/>
        <ui:Button text="Continue" name="ContinueButton" class="BotonUIStart" style="top: 824px; left: 1345px;"/>
        <ui:VisualElement name="PanelTexto1" enabled="true" style="flex-grow: 1; position: absolute; height: 536px; width: 1698px; top: 168px; left: 40px; display: flex;">
            <ui:Label text="You&apos;ve found your first clue!" name="Text1" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(153, 0, 0); -unity-text-outline-width: 0.5px; font-size: 40px; -unity-text-outline-color: rgb(0, 0, 0); top: 4px; left: 3px; -unity-text-align: upper-left; width: 751px;"/>
            <ui:Label text="You&apos;ve found a bottle that might be connected to the crime. Examine it carefully; even the smallest detail could be &#10;important in uncovering the killer." name="Text2" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 0; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); top: 90px; left: 3px; -unity-text-align: upper-left; width: 1564px;"/>
            <ui:Label text="Your clues will be saved automatically." name="Text3" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 0; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); top: 176px; left: 3px; -unity-text-align: upper-left; width: 1564px;"/>
            <ui:Label text="You can view all the clues you&apos;ve found in the investigation menu." name="Text4" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 0; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); top: 229px; left: 3px; -unity-text-align: upper-left; width: 1564px;"/>
            <ui:Label text="Press [P] to open the clue list." name="Text5" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(153, 0, 0); -unity-text-outline-width: 0; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); top: 286px; left: 3px; -unity-text-align: upper-left; width: 1564px;"/>
            <ui:Label text="Now go to the Town Hall and talk to Mayor Elias.&#10;Tell him what you found and the situation in the town. He might be able to help you find out what happened.&#10;&#10;Every clue counts. Can you uncover the truth?" name="Text6" style="position: absolute; background-color: rgba(255, 255, 255, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/suarez/Font/thug-life.regular.ttf?fileID=12800000&amp;guid=5b947d4af74e9414298cfff55c5e6e2b&amp;type=3#thug-life.regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 0; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); top: 344px; left: 3px; -unity-text-align: upper-left; width: 1564px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
