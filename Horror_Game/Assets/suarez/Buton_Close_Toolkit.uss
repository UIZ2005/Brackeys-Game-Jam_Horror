:root {
}

.Button_Close {
    background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&guid=550fa718f45ed104e91c3148589c9b50&type=3#Remove@2x");
    background-color: rgb(236, 166, 95);
    border-left-color: rgb(69, 28, 4);
    border-right-color: rgb(69, 28, 4);
    border-top-color: rgb(69, 28, 4);
    border-bottom-color: rgb(69, 28, 4);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-right-radius: 38px;
    border-bottom-left-radius: 38px;
    transition-duration: 0.2s;
    -unity-background-image-tint-color: rgba(255, 0, 0, 0);
}

.Button_Close:hover {
    background-color: rgb(70, 70, 70);
    background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&guid=550fa718f45ed104e91c3148589c9b50&type=3#Remove@2x");
    border-left-color: rgb(69, 28, 4);
    border-right-color: rgb(69, 28, 4);
    border-top-color: rgb(69, 28, 4);
    border-bottom-color: rgb(69, 28, 4);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-right-radius: 38px;
    border-bottom-left-radius: 38px;
    scale: 1.5 1.5;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}
