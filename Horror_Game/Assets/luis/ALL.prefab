  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  efect: 1
  nombreNpc: ines
  dialogoMark: {fileID: 1020857744546760302}
  dialogopanel: {fileID: 4046422045363295102}
  caradialogo: {fileID: 4161174153705769723}
  Cara: {fileID: 3841931496052244575, guid: 99247e5f49332fd4e99ae73d53df514f, type: 3}
  texto: {fileID: 2577184535149988378}
  lineasDialogo:
  - Gabriel stopped by the school this afternoon. He seemed worried, but he didn't
    want to tell me what was wrong.
  - 'Maybe someone at the bar knows more than they''re saying. '
  lineasDialogoDespuesPista: []
  ispista: 1
  pistaTexto: Gabriel seemed worried before he died.
