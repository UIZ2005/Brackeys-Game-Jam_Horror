  nombreNpc: ines
  dialogoMark: {fileID: 7288754434035300669}
  dialogopanel: {fileID: 4046422045363295102}
  caradialogo: {fileID: 4161174153705769723}
  Cara: {fileID: 3841931496052244575, guid: 99247e5f49332fd4e99ae73d53df514f, type: 3}
  texto: {fileID: 2577184535149988378}
  lineasDialogo:
  - "Gabriel pas\xF3 por la escuela esta tarde. Parec\xEDa preocupado, pero no quiso
    contarme qu\xE9 ocurr\xEDa. "
  - "Quiz\xE1 alguien del bar sepa m\xE1s de lo que est\xE1 diciendo. "
  lineasDialogoDespuesPista: []
  ispista: 1
  pistaTexto: "Gabriel parec\xEDa preocupado antes de morir."
