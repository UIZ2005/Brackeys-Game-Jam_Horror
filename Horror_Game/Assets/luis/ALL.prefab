  m_GameObject: {fileID: 1688172925119265841}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 295b917049e2886478597097a288e5e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  efect: -1
  nombreNpc: 
  dialogoMark: {fileID: 5040215393569371138}
  dialogopanel: {fileID: 2393372114966500067}
  caradialogo: {fileID: 0}
  Cara: {fileID: 0}
  texto: {fileID: 1692663152014875286}
  lineasDialogo:
  - "Querida Clara,\n\nNecesito hablar contigo sobre Gabriel.\r\n\r\nHay algo que
    no coincide con lo que todos est\xE1n diciendo.\r\n\r\nNo quiero hablar de esto
    en p\xFAblico.\r\n"
  lineasDialogoDespuesPista: []
  ispista: 1
  pistaTexto: Alguien anonimo esta indagando acerca de las heridas de Gabriel.
