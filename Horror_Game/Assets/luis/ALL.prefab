  nombreNpc: marta
  dialogoMark: {fileID: 9052282107139784760}
  dialogopanel: {fileID: 4046422045363295102}
  caradialogo: {fileID: 4161174153705769723}
  Cara: {fileID: -737684903646139153, guid: 4fbf44192525a104c8bb18354a14efd6, type: 3}
  texto: {fileID: 2577184535149988378}
  lineasDialogo:
  - Gabriel was here this afternoon. He was talking to someone, but I didn't get
    a good look at who it was.
  - When I turned around, they were both gone.
  lineasDialogoDespuesPista: []
  ispista: 1
  pistaTexto: Gabriel was with someone before he died.
