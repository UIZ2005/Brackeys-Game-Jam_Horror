  caradialogo: {fileID: 0}
  Cara: {fileID: 0}
  texto: {fileID: 3912343489236762823}
  lineasDialogo:
  - "Querida ines\n\nNecesito hablar contigo sobre lo que ocurri\xF3 aquella tarde.\r\n\r\nNo
    puedo seguir guardando esto por m\xE1s tiempo.\r\n\r\nNos vemos despu\xE9s de
    clases. Es importante que vengas sola."
