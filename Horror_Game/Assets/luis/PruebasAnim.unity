  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 295b917049e2886478597097a288e5e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: 
  dialogoMark: {fileID: 1898897597}
  dialogopanel: {fileID: 335423364}
  caradialogo: {fileID: 0}
  Cara: {fileID: 0}
  texto: {fileID: 1820087832}
  lineasDialogo:
  - "Querida Marta,\n\nTe dejo anotado que ma\xF1ana pasar\xE9 por el bar a recoger
    las botellas que encargu\xE9.\r\n\r\nSi puedes guardarme las grandes, te lo agradecer\xEDa.\r\n\r\n\u2014
    Gabriel"
  ispista: 0
  pistaTexto: 
