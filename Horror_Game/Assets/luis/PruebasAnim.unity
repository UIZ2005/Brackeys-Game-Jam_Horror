--- !u!114 &932421359
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 932421357}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 295b917049e2886478597097a288e5e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: 
  dialogoMark: {fileID: 1145499933}
  dialogopanel: {fileID: 335423364}
  caradialogo: {fileID: 0}
  Cara: {fileID: 0}
  texto: {fileID: 1820087832}
  lineasDialogo:
  - "Dear Marta,\n\nJust a note to let you know that I'll stop by the bar tomorrow
    to pick up the bottles I ordered.\n\nIf you could save the large ones for me,
    I'd appreciate it.\n\n\u2014 Gabriel"
  ispista: 0
  pistaTexto: 
