  nombreNpc: 
  dialogoMark: {fileID: 505294361}
  dialogopanel: {fileID: 335423364}
  caradialogo: {fileID: 0}
  Cara: {fileID: 0}
  texto: {fileID: 315010211}
  lineasDialogo:
  - 'Dear Ines,


    I need to talk to you about what happened that afternoon.


    I
    can''t keep this to myself any longer.


    I''ll see you after school. It''s
    important that you come alone.'
  ispista: 0
  pistaTexto: 
