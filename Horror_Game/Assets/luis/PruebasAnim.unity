  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: 
  dialogoMark: {fileID: 1059737624}
  dialogopanel: {fileID: 335423364}
  caradialogo: {fileID: 0}
  Cara: {fileID: 0}
  texto: {fileID: 315010211}
  lineasDialogo:
  - 'Dear Marta,


    You said you saw Gabriel talking to someone that afternoon.


    I
    need to know who it was.


    Think carefully before you answer.


    I don''t
    want you to make the same mistake as the others.'
  ispista: 0
  pistaTexto: 
