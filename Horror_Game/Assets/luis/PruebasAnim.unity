  m_Script: {fileID: 11500000, guid: 295b917049e2886478597097a288e5e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Diaologo
  nombreNpc: marta
  dialogoMark: {fileID: 655622167}
  dialogopanel: {fileID: 794680974}
  caradialogo: {fileID: 1128739661}
  Cara: {fileID: -737684903646139153, guid: 4fbf44192525a104c8bb18354a14efd6, type: 3}
  texto: {fileID: 1980136210}
  lineasDialogo:
  - "Gabriel estuvo aqu\xED esta tarde. Estaba hablando con alguien, pero no alcanc\xE9
    a ver qui\xE9n era. "
  - "Cuando me di la vuelta, ya se hab\xEDan ido los dos."
  lineasDialogoDespuesPista: []
  ispista: 1
  pistaTexto: "Gabriel estuvo acompa\xF1ado antes de morir."
